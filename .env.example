# Copiez ce fichier en .env et renseignez les valeurs. Le fichier .env ne doit jamais être commité.

# Adresse à laquelle vous ouvrez l'outil dans le navigateur. Elle sert à construire l'adresse de retour
# de la connexion Google : <PUBLIC_URL>/auth/callback, à déclarer dans votre projet Google Cloud.
PUBLIC_URL=http://localhost:8080

# Identifiants OAuth de votre projet Google Cloud (type « Application Web »).
# Laissés vides, le serveur démarre et affiche le guide de première installation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Adresses Google autorisées à se connecter, séparées par des virgules.
ALLOWED_EMAILS=

# Clé qui chiffre les jetons Google en base : au moins 32 caractères aléatoires.
# Exemple : openssl rand -base64 32
ENCRYPTION_KEY=

# Port d'écoute (optionnel, 8080 par défaut).
PORT=8080
